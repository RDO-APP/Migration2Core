@{
    Layout = "_Layout";
    ViewData["Title"] = "Tarefas";
    var obraNome = ViewData["ObraNome"]?.ToString() ?? "Obra";
    var obraId = ViewData["ObraId"];
}

<div class="container py-4">
    <h1 class="h3">Tarefas</h1>
    <p class="text-muted">Obra ativa: <strong>@obraNome</strong> (ID @obraId)</p>
    <p class="mb-0">Placeholder Fase 1 — cards de tarefa serão implementados aqui.</p>
</div>
