@using Microsoft.AspNetCore.Components.Forms
@using RdoApp.Core.Models.ViewModels
@using RdoApp.Core.Models.Requests
@using RdoApp.Core.Services.Interfaces
@inject IEtapaService EtapaService
@inject ITarefaService TarefaService
@inject NavigationManager Navigation

@* PURE BLAZOR COMPONENT - Hosted by MVC CardsBlazor action *@

<!-- PURE BLAZOR ETAPA CARDS PAGE - ZERO JAVASCRIPT DEPENDENCIES -->
<PageTitle>Etapas / Tarefas - Blazor</PageTitle>

<section class="etapa-tarefa-cards">
    <!-- Header with actions -->
    <div class="panel-heading">
        <h3>Etapas / Tarefas (Pure Blazor)</h3>
        <div class="action pull-right">
            <button class="btn btn-simple" @onclick="@(() => Navigation.NavigateTo($"/etapa/lista/{ObraId}"))">
                <i class="fa fa-columns"></i>
            </button>
        </div>
    </div>

    <!-- Loading State -->
    @if (IsLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p>Carregando etapas e tarefas...</p>
        </div>
    }

    <!-- Error Display -->
    @if (HasError)
    {
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle"></i>
            @ErrorMessage
        </div>
    }

    <!-- Main Content -->
    @if (Model?.Etapas?.Any() == true)
    {
        <div class="lista-tarefas">
            <!-- Production Reality Status -->
            <div class="alert alert-info" role="alert">
                <i class="fas fa-database"></i>
                <strong>Sistema Ativo!</strong> Carregando dados reais do banco de dados com @Model.Etapas.Sum(e => e.Tarefas.Count) tarefas em @Model.Etapas.Count etapas.
            </div>

            <!-- Accordion with Etapas -->
            <div class="accordion" id="blazor-accordion">
                @foreach (var etapa in Model.Etapas)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-@etapa.Id">
                            <button class="accordion-button @(etapa.IsExpanded ? "" : "collapsed")" 
                                    type="button" 
                                    @onclick="@(() => ToggleEtapa(etapa.Id))">
                                <strong>@etapa.Descricao</strong>
                                <span class="badge bg-primary ms-2">@etapa.Tarefas.Count tarefas</span>
                            </button>
                        </h2>
                        <div class="accordion-collapse collapse @(etapa.IsExpanded ? "show" : "")" 
                             id="collapse-@etapa.Id">
                            <div class="accordion-body">
                                @if (etapa.Tarefas?.Any() == true)
                                {
                                    <div class="row">
                                        @foreach (var tarefa in etapa.Tarefas)
                                        {
                                            <div class="col-lg-4 col-md-6 col-sm-12 mb-3">
                                                <TaskCard Task="@tarefa"
                                                         CanEdit="@Model.CanEdit"
                                                         IsWorkFinalized="@Model.IsWorkFinalized"
                                                         OnViewTask="@HandleViewTask"
                                                         OnShowHistory="@HandleShowHistory"
                                                         OnDeleteTask="@HandleDeleteTask"
                                                         OnEditTask="@HandleEditTask"
                                                         OnAddMeasurement="@HandleAddMeasurement" />
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">Nenhuma tarefa cadastrada para esta etapa.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (!IsLoading)
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i>
            Nenhuma etapa cadastrada para esta obra.
        </div>
    }

    <!-- Pure Blazor Nova Medição Modal -->
    <NovaMedicaoModal @ref="novaMedicaoModal" 
                      OnMeasurementSaved="@HandleMeasurementSaved" />
</section>

@code {
    [Parameter] public int ObraId { get; set; }
    
    private EtapaCardsViewModel Model = new();
    private NovaMedicaoModal novaMedicaoModal = default!;
    private bool IsLoading = true;
    private bool HasError = false;
    private string ErrorMessage = "";

    /// <summary>
    /// Initialize page - Load etapas and tarefas
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"🔌 BLAZOR CIRCUIT: Component initializing for Obra {ObraId}");
        await LoadData();
    }

    /// <summary>
    /// After render - Log circuit status
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("✅ BLAZOR CIRCUIT: Component rendered successfully");
            Console.WriteLine($"📊 DATA STATUS: {Model?.Etapas?.Count ?? 0} etapas loaded");
        }
    }

    /// <summary>
    /// Load etapas and tarefas data from database
    /// </summary>
    private async Task LoadData()
    {
        try
        {
            IsLoading = true;
            HasError = false;
            StateHasChanged();

            // REAL DATA: Load from database using EtapaService
            var filter = new EtapaFilterViewModel
            {
                IdObra = ObraId
            };

            var etapas = await EtapaService.GetEtapasWithTarefasAsync(filter);
            
            // Build view model with real data
            Model = new EtapaCardsViewModel
            {
                CurrentObraId = ObraId,
                Etapas = etapas.ToList(),
                CanEdit = true, // TODO: Get from user permissions
                IsWorkFinalized = false, // TODO: Get from obra status
                Filter = filter
            };
            
            // Expand first etapa by default
            if (Model.Etapas.Any())
            {
                Model.Etapas.First().IsExpanded = true;
            }
            
            // Log real data loading for debugging
            Console.WriteLine($"🔥 PRODUCTION REALITY - REAL DATA LOADED: {Model.Etapas.Count} etapas, {Model.Etapas.Sum(e => e.Tarefas.Count)} total tasks for Obra {ObraId}");
            
            // Log status distribution for verification
            var statusCounts = Model.Etapas.SelectMany(e => e.Tarefas)
                .GroupBy(t => t.StatusId)
                .ToDictionary(g => g.Key, g => g.Count());
            
            foreach (var status in statusCounts)
            {
                Console.WriteLine($"✅ STATUS {status.Key}: {status.Value} tasks");
            }
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Erro ao carregar dados: {ex.Message}";
            Console.WriteLine($"❌ DATABASE ERROR: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Toggle etapa accordion expansion
    /// </summary>
    private void ToggleEtapa(int etapaId)
    {
        var etapa = Model.Etapas.FirstOrDefault(e => e.Id == etapaId);
        if (etapa != null)
        {
            etapa.IsExpanded = !etapa.IsExpanded;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handle View Task request - Pure Blazor navigation
    /// </summary>
    private async Task HandleViewTask(ViewTaskRequest request)
    {
        Navigation.NavigateTo($"/tarefa/visualizar/{request.TaskId}");
        await Task.CompletedTask;
    }

    /// <summary>
    /// Handle Show History request - Pure Blazor modal (TODO)
    /// </summary>
    private async Task HandleShowHistory(HistoryTaskRequest request)
    {
        // TODO: Implement Pure Blazor history modal component
        // For now, navigate to history page
        Navigation.NavigateTo($"/tarefa/historico/{request.TaskId}");
        await Task.CompletedTask;
    }

    /// <summary>
    /// Handle Delete Task request - Pure Blazor confirmation
    /// </summary>
    private async Task HandleDeleteTask(DeleteTaskRequest request)
    {
        // TODO: Implement Pure Blazor confirmation modal
        // For now, use simple confirmation logic
        try
        {
            // Call real service to delete task
            await TarefaService.DeleteAsync(request.TaskId);
            
            // Remove from model and refresh
            foreach (var etapa in Model.Etapas)
            {
                etapa.Tarefas.RemoveAll(t => t.Id == request.TaskId);
            }
            
            StateHasChanged();
            
            // TODO: Show success message via Pure Blazor toast component
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Erro ao excluir tarefa: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Handle Edit Task request - Pure Blazor navigation
    /// </summary>
    private async Task HandleEditTask(EditTaskRequest request)
    {
        Navigation.NavigateTo($"/tarefa/editar/{request.TaskId}");
        await Task.CompletedTask;
    }

    /// <summary>
    /// Handle Add Measurement request - Pure Blazor modal with real data
    /// </summary>
    private async Task HandleAddMeasurement(NovaMedicaoRequest request)
    {
        if (novaMedicaoModal != null)
        {
            // Pass real task ID from database
            await novaMedicaoModal.ShowAsync(request.TaskId, request.TaskDescription, request.CurrentStatus);
        }
    }

    /// <summary>
    /// Handle measurement saved - Refresh data from database
    /// </summary>
    private async Task HandleMeasurementSaved(NovaMedicaoResult result)
    {
        if (result.Success && result.RefreshRequired)
        {
            // Reload real data from database
            await LoadData();
        }
    }
}