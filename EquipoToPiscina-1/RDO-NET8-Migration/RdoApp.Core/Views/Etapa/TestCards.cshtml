@model List<TarefaViewModel>
@{
    ViewData["Title"] = "Test Hand Icons";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/task-cards-compact.css" />
    <style>
        .test-container {
            padding: 20px;
            background: #f5f5f5;
        }
        
        .test-card {
            background: white;
            border: 1px solid #ddd;
            margin: 10px 0;
            padding: 15px;
            border-radius: 4px;
        }
        
        .test-header {
            background-color: #5bc0de;
            color: white;
            padding: 10px;
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
        
        .test-header i {
            margin-right: 10px;
            font-size: 16px;
        }
        
        .status-info {
            margin-left: auto;
            font-size: 12px;
        }
    </style>
}

<div class="test-container">
    <h1>🧪 TEST HAND ICONS - Status Verification</h1>
    
    <div class="alert alert-info">
        <strong>Purpose:</strong> This page tests if hand icons are working correctly for all 5 status types.
        <br><strong>Expected:</strong> Each card should show a different hand icon (paper, rock, peace, stop, scissors).
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var task in Model)
        {
            <div class="test-card">
                <div class="test-header">
                    @switch (task.StatusId)
                    {
                        case 1: // Planejada
                            <i class="fa fa-hand-paper-o" title="Planejada" style="color: white;"></i>
                            break;
                        case 2: // Em Execução
                            <i class="fa fa-hand-rock-o" title="Em Execução" style="color: white;"></i>
                            break;
                        case 3: // Finalizada
                            <i class="fa fa-hand-peace-o" title="Finalizada" style="color: white;"></i>
                            break;
                        case 4: // Paralisada
                            <i class="fa fa-hand-stop-o" title="Paralisada" style="color: white;"></i>
                            break;
                        case 5: // Cancelada
                            <i class="fa fa-hand-scissors-o" title="Cancelada" style="color: white;"></i>
                            break;
                        default:
                            <i class="fa fa-hand-paper-o" title="Status Desconhecido" style="color: white;"></i>
                            break;
                    }
                    
                    <strong>@task.Descricao</strong>
                    
                    <div class="status-info">
                        StatusId: @task.StatusId
                    </div>
                </div>
                
                <div>
                    <p><strong>Task ID:</strong> @task.Id</p>
                    <p><strong>Status ID:</strong> @task.StatusId</p>
                    <p><strong>Description:</strong> @task.Descricao</p>
                    <p><strong>Colaboradores:</strong> @task.QuantidadeColaboradores</p>
                    <p><strong>Equipamentos:</strong> @task.QuantidadeEquipamentos</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            <strong>No test data available.</strong> The controller should provide 5 test tasks with different StatusId values.
        </div>
    }

    <hr>
    
    <h2>🔍 FontAwesome Icon Test</h2>
    <div class="test-card">
        <div class="test-header">
            <i class="fa fa-hand-paper-o" style="color: white;"></i> Paper (StatusId 1)
        </div>
        <div class="test-header">
            <i class="fa fa-hand-rock-o" style="color: white;"></i> Rock (StatusId 2)
        </div>
        <div class="test-header">
            <i class="fa fa-hand-peace-o" style="color: white;"></i> Peace (StatusId 3)
        </div>
        <div class="test-header">
            <i class="fa fa-hand-stop-o" style="color: white;"></i> Stop (StatusId 4)
        </div>
        <div class="test-header">
            <i class="fa fa-hand-scissors-o" style="color: white;"></i> Scissors (StatusId 5)
        </div>
    </div>

    <div class="alert alert-success">
        <strong>✅ If you can see all 5 different hand icons above:</strong> FontAwesome is loaded correctly.
        <br><strong>❌ If icons are missing or showing as squares:</strong> FontAwesome CSS is not loaded.
    </div>

    <hr>
    
    <h2>🔗 Navigation Links</h2>
    <p>
        <a href="/Etapa/Cards" class="btn btn-primary">Go to Main Cards View</a>
        <a href="/tarefa/cards" class="btn btn-secondary">Alternative Cards Route</a>
    </p>
    
    <div class="alert alert-warning">
        <strong>Important:</strong> Make sure you're accessing the Razor version (/Etapa/Cards) and NOT the old AngularJS version.
    </div>
</div>