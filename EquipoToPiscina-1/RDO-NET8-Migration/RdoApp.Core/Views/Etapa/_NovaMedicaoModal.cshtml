<div class="modal fade" id="manual-modal-medicao-2026" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" onclick="nuclearHideModal()" aria-hidden="true">
                    <i class="icon-close"></i>
                </button>
                <div class="panel-heading">
                    <h4>Nova Medição - <span id="nova-medicao-descricao">Tarefa</span></h4>
                </div>
            </div>

            <div class="modal-body">
                <form id="form-nova-medicao">
                    <div class="row">
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group is-empty">
                                <label class="control-label">Status<span style="color:red">*</span></label>
                                <select class="form-control" id="nova-medicao-status" name="status" required>
                                    <option value="">Selecione...</option>
                                    <option value="1">Planejada</option>
                                    <option value="2">Em Execução</option>
                                    <option value="3">Finalizada</option>
                                    <option value="4">Paralisada</option>
                                    <option value="5">Cancelada</option>
                                </select>
                                <span class="material-input"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Data<span style="color:red">*</span></label>
                                <input type="date" class="form-control" id="nova-medicao-data" name="dataMedicao" required>
                                <span class="material-input"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Hora Inicial</label>
                                <input type="time" class="form-control" id="nova-medicao-hora-inicial" name="horaInicial">
                                <span class="material-input"></span>
                            </div>
                        </div>
                        
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Hora Final</label>
                                <input type="time" class="form-control" id="nova-medicao-hora-final" name="horaFinal">
                                <span class="material-input"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- FIXED: NO MASKMONEY - Using type="number" with step="0.01" -->
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Quantidade</label>
                                <input type="number" step="0.01" min="0" class="form-control" id="nova-medicao-quantidade" name="qtdConstruida" placeholder="0.00">
                                <span class="material-input"></span>
                            </div>
                        </div>

                        <!-- GILBERTO'S ORIGINAL WATER QUALITY DROPDOWNS -->
                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Cloro</label>
                                <select class="form-control" id="nova-medicao-cloro" name="nivelCloro">
                                    <option value="">Selecione</option>
                                    <option value="1">0 ppm</option>
                                    <option value="2">0,5 < 1,0</option>
                                    <option value="3">1,5 < 2,0</option>
                                    <option value="4">2,5 < 3,0</option>
                                    <option value="5">> 3,0</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">PH</label>
                                <select class="form-control" id="nova-medicao-ph" name="ph">
                                    <option value="">Selecione</option>
                                    <option value="1">< 7.0</option>
                                    <option value="2">7.0 < 7.2</option>
                                    <option value="3">7.2 < 7.4</option>
                                    <option value="4">7.4 < 7.6</option>
                                    <option value="5">7.6 < 7.8</option>
                                    <option value="6">> 7.8</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-12">
                            <div class="form-group">
                                <label class="control-label">Alcalinidade</label>
                                <select class="form-control" id="nova-medicao-alcalinidade" name="alcalinidade">
                                    <option value="">Selecione</option>
                                    <option value="1">< 70</option>
                                    <option value="2">70 < 80</option>
                                    <option value="3">90 < 100</option>
                                    <option value="4">110 < 120</option>
                                    <option value="5">130 > 140</option>
                                    <option value="6">> 140</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- GILBERTO'S ORIGINAL WATER QUALITY RADIO BUTTONS -->
                    <div class="row novoscards px-sm-6">
                        <div class="col-md-4 col-sm-6">
                            <div class="form-group">
                                <label>Limpidez</label><br>
                                <input type="radio" name="limpidez" value="true" id="limpidez-sim"> 
                                <label for="limpidez-sim">Sim</label>
                                <input type="radio" name="limpidez" value="false" id="limpidez-nao" checked> 
                                <label for="limpidez-nao">Não</label>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="form-group">
                                <label>Materiais flutuantes</label><br>
                                <input type="radio" name="superficie" value="true" id="superficie-sim"> 
                                <label for="superficie-sim">Sim</label>
                                <input type="radio" name="superficie" value="false" id="superficie-nao" checked> 
                                <label for="superficie-nao">Não</label>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="form-group">
                                <label>Areia no fundo</label><br>
                                <input type="radio" name="fundo" value="true" id="fundo-sim"> 
                                <label for="fundo-sim">Sim</label>
                                <input type="radio" name="fundo" value="false" id="fundo-nao" checked> 
                                <label for="fundo-nao">Não</label>
                            </div>
                        </div>

                        <div class="col-md-4 col-sm-6">
                            <div class="form-group">
                                <label>Algas</label><br>
                                <input type="radio" name="nivelProliferacao" value="true" id="proliferacao-sim"> 
                                <label for="proliferacao-sim">Sim</label>
                                <input type="radio" name="nivelProliferacao" value="false" id="proliferacao-nao" checked> 
                                <label for="proliferacao-nao">Não</label>
                            </div>
                        </div>

                        <!-- CRITICAL FIX: 'Nível de Detritos' (UI) MUST save to tar_nr_nivel_bacteria (Database) -->
                        <div class="col-md-4 col-sm-6">
                            <div class="form-group">
                                <label>Nível de Detritos</label><br>
                                <input type="radio" name="nivelDetritos" value="true" id="detritos-sim"> 
                                <label for="detritos-sim">Sim</label>
                                <input type="radio" name="nivelDetritos" value="false" id="detritos-nao" checked> 
                                <label for="detritos-nao">Não</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <div class="form-group">
                            <label class="control-label">Comentário</label>
                            <textarea class="form-control" id="nova-medicao-comentario" name="comentario" maxlength="1400" rows="4"></textarea>
                            <span class="material-input"></span>
                        </div>
                    </div>

                    <input type="hidden" id="nova-medicao-tarefa-id" name="tarefaId">
                </form>
            </div>

            <div class="modal-footer">
                <div class="col-xs-12">
                    <button type="button" class="btn btn-blue btn-block-xs" onclick="nuclearSaveModal()">
                        <i class="fa fa-save"></i>
                        SALVAR
                    </button>
                    <button type="button" class="btn btn-simple" onclick="nuclearHideModal()">
                        <i class="icon-close" aria-hidden="true"></i>
                        Cancelar
                    </button>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>