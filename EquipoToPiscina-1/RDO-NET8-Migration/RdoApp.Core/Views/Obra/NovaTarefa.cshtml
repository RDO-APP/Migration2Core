@{
    ViewData["Title"] = "Nova Tarefa";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-clipboard me-2"></i>
                        Nova Tarefa
                    </h4>
                </div>
                <div class="card-body">
                    <form>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Descrição <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="Digite a descrição da tarefa">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Etapa <span class="text-danger">*</span></label>
                                    <select class="form-select">
                                        <option value="">Selecione uma etapa</option>
                                        <option value="1">Preparação da Piscina</option>
                                        <option value="2">Manutenção e Limpeza</option>
                                        <option value="3">Finalização e Entrega</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Data Início Planejada</label>
                                    <input type="date" class="form-control">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Data Fim Planejada</label>
                                    <input type="date" class="form-control">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label">Observações</label>
                                    <textarea class="form-control" rows="3" placeholder="Observações adicionais sobre a tarefa"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Etapas", "Obra")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>
                                Voltar
                            </a>
                            <div>
                                <button type="button" class="btn btn-outline-secondary me-2">
                                    <i class="fas fa-times me-1"></i>
                                    Cancelar
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i>
                                    Salvar Tarefa
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>