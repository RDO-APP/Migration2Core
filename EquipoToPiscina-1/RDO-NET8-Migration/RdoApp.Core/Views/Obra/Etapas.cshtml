                    <select class="form-select">
                        <option value="">Todos</option>
                        <option value="1">Planejada</option>
                        <option value="2">Em ExecuÃ§Ã£o</option>
                        <option value="3">Finalizada</option>
                        <option value="4">Paralisada</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data Inicial Executada</label>
                    <input type="date" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data Final Executada</label>
