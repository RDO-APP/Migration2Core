<script>
// FRONTEND INTEGRITY FIX: JavaScript Error Handling Framework
class RdoErrorHandler {
    static init() {
        // Global error handler for unhandled JavaScript errors
        window.onerror = function(message, source, lineno, colno, error) {
            console.error('🚨 FRONTEND INTEGRITY FIX: JavaScript Error Caught:', {
                message: message,
                source: source,
                line: lineno,
                column: colno,
                error: error
            });
            
            // Show user-friendly error message
            RdoErrorHandler.showUserError('Erro JavaScript detectado. A página pode não funcionar corretamente.');
            
            // Don't prevent default error handling
            return false;
        };

        // Handle unhandled promise rejections
        window.addEventListener('unhandledrejection', function(event) {
            console.error('🚨 FRONTEND INTEGRITY FIX: Unhandled Promise Rejection:', event.reason);
            RdoErrorHandler.showUserError('Erro de carregamento detectado. Alguns recursos podem não estar disponíveis.');
        });

        console.log('✅ FRONTEND INTEGRITY FIX: Error handling framework initialized');
    }

    static safeExecute(func, fallbackMessage = 'Operação não pôde ser executada') {
        try {
            return func();
        } catch (error) {
            console.error('🚨 FRONTEND INTEGRITY FIX: Safe execution failed:', error);
            RdoErrorHandler.showUserError(fallbackMessage);
            return null;
        }
    }

    static showUserError(message) {
        // Create or update error notification
        let errorDiv = document.getElementById('rdoErrorNotification');
        if (!errorDiv) {
            errorDiv = document.createElement('div');
            errorDiv.id = 'rdoErrorNotification';
            errorDiv.className = 'alert alert-warning alert-dismissible fade show position-fixed';
            errorDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; max-width: 400px;';
            document.body.appendChild(errorDiv);
        }

        errorDiv.innerHTML = `
            <i class="fas fa-exclamation-triangle me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

        // Auto-hide after 5 seconds
        setTimeout(() => {
            if (errorDiv && errorDiv.parentNode) {
                errorDiv.remove();
            }
        }, 5000);
    }
}

// GILBERTO'S SOURCE OF TRUTH: Lazy Loading Pattern Implementation
class EtapaTaskLoader {
    constructor() {
        this.loadedEtapas = new Set(); // Track which etapas have been loaded
        this.taskCache = {}; // Cache loaded tasks
    }

    /**
     * Load tasks for a specific etapa (mimics Gilberto's loadCards function)
     * This is the "Source of Truth" implementation
     */
    async loadTasksForEtapa(etapaDescricao, etapaId, etapaIndex) {
        return RdoErrorHandler.safeExecute(async () => {
            console.log(`🔥 GILBERTO PATTERN: Loading tasks for "${etapaDescricao}" (ID: ${etapaId}, Index: ${etapaIndex})`);

            // Check if already loaded (Gilberto's pattern: if (!controller.cardsArray[titulo]))
            if (this.loadedEtapas.has(etapaId)) {
                console.log(`✅ GILBERTO PATTERN: Tasks already loaded for Etapa ${etapaId}`);
                return;
            }

            const container = document.getElementById(`tasks-container-${etapaIndex}`);
            const loadingDiv = document.getElementById(`loading-etapa${etapaIndex}`);
            
            if (!container) {
                console.error(`❌ GILBERTO PATTERN: Container not found for etapa ${etapaIndex}`);
                return;
            }

            // Show loading indicator
            if (loadingDiv) {
                loadingDiv.style.display = 'block';
            }

            try {
                // Call our API that mimics Gilberto's backend pattern
                const response = await fetch(`/api/EtapaTasks/LoadTasks/${etapaId}?colaboradorId=1`);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }

                const tarefas = await response.json();
                console.log(`✅ GILBERTO PATTERN: Loaded ${tarefas.length} tasks for Etapa ${etapaId}`);

                // Cache the results (Gilberto's pattern: controller.cardsArray[titulo] = values[0])
                this.taskCache[etapaId] = tarefas;
                this.loadedEtapas.add(etapaId);

                // Render tasks in the container
                this.renderTasks(container, tarefas, etapaId);

            } catch (error) {
                console.error(`❌ GILBERTO PATTERN: Failed to load tasks for Etapa ${etapaId}:`, error);
                
                // Show error message in container
                container.innerHTML = `
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Erro ao carregar tarefas. <button class="btn btn-link p-0" onclick="etapaTaskLoader.retryLoadTasks('${etapaDescricao}', ${etapaId}, ${etapaIndex})">Tentar novamente</button>
                    </div>
                `;
            } finally {
                // Hide loading indicator
                if (loadingDiv) {
                    loadingDiv.style.display = 'none';
                }
            }
        }, `Não foi possível carregar as tarefas da etapa ${etapaDescricao}`);
    }

    /**
     * Render tasks in the container (mimics Gilberto's ng-repeat pattern)
     */
    renderTasks(container, tarefas, etapaId) {
        if (!tarefas || tarefas.length === 0) {
            container.innerHTML = `
                <div class="text-center w-100 mb-3">
                    <p class="text-muted">Nenhuma tarefa cadastrada nesta etapa.</p>
                </div>
            `;
            return;
        }

        const tasksHtml = tarefas.map(tarefa => this.renderTaskCard(tarefa)).join('');
        container.innerHTML = tasksHtml;

        console.log(`✅ GILBERTO PATTERN: Rendered ${tarefas.length} task cards for Etapa ${etapaId}`);
    }

    /**
     * Render individual task card (mimics Gilberto's card template)
     */
    renderTaskCard(tarefa) {
        const statusIcon = this.getStatusIcon(tarefa.statusId);
        const statusClass = tarefa.statusCssClass || this.getStatusClass(tarefa.statusId);

        return `
            <div class="task-card">
                <div class="task-card-header ${statusClass}">
                    <h6 class="task-card-title">${tarefa.descricao || `Tarefa ${tarefa.id}`}</h6>
                    <button class="task-card-menu" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                    <ul class="dropdown-menu">
                        ${tarefa.podeIniciar ? '<li><a class="dropdown-item" href="#"><i class="fas fa-play me-1"></i> Iniciar</a></li>' : ''}
                        ${tarefa.podePausar ? '<li><a class="dropdown-item" href="#"><i class="fas fa-pause me-1"></i> Pausar</a></li>' : ''}
                        ${tarefa.podeFinalizar ? '<li><a class="dropdown-item" href="#"><i class="fas fa-check me-1"></i> Finalizar</a></li>' : ''}
                    </ul>
                    
                    <div class="task-card-stats">
                        <div class="task-card-stat">
                            <i class="fas fa-users"></i>
                            <span>${tarefa.quantidadeColaboradores || 0}</span>
                        </div>
                        <div class="task-card-stat">
                            <i class="fas fa-tools"></i>
                            <span>${tarefa.quantidadeEquipamentos || 0}</span>
                        </div>
                    </div>
                </div>
                
                <div class="task-card-body">
                    <div class="task-dates">
                        <div class="task-date planned">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Planejado: ${this.formatDate(tarefa.dataInicio)} à ${this.formatDate(tarefa.dataPrevisaoFim)}</span>
                        </div>
                        <div class="task-date executed">
                            <i class="fas fa-calendar-check"></i>
                            <span>Executado: ${this.formatDate(tarefa.dataMedicao)} à ${this.formatDate(tarefa.dataFim)}</span>
                        </div>
                    </div>
                    
                    <div class="task-progress">
                        <div class="progress-custom">
                            <div class="progress-bar-custom ${tarefa.percentualExtrapolado ? 'bg-warning' : ''}" style="width: ${Math.min(tarefa.percentualConclusao || 0, 100)}%;">
                                ${(tarefa.percentualConclusao || 0).toFixed(1)}%
                            </div>
                        </div>
                    </div>
                    
                    <div class="task-actions">
                        <button class="task-action-btn" title="Visualizar">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="task-action-btn" title="Histórico" onclick="abrirHistoricoTarefa(${tarefa.id}, '${tarefa.descricao}')">
                            <i class="fas fa-clock"></i>
                        </button>
                        ${tarefa.podeAdicionarMedicao ? `<button class="task-action-btn" title="Nova Medição" onclick="abrirModalNovaMedicao(${tarefa.id}, '${tarefa.descricao}')"><i class="fas fa-plus"></i></button>` : ''}
                        ${tarefa.podeEditar ? '<button class="task-action-btn" title="Editar"><i class="fas fa-edit"></i></button>' : ''}
                        ${tarefa.podeExcluir ? '<button class="task-action-btn" title="Excluir"><i class="fas fa-trash"></i></button>' : ''}
                    </div>
                    
                    <button class="task-status-btn ${statusClass}">
                        <i class="fas ${statusIcon} me-1"></i>
                        ${tarefa.statusDescricao || this.getStatusDescription(tarefa.statusId)}
                    </button>
                </div>
            </div>
        `;
    }

    /**
     * Retry loading tasks (for error recovery)
     */
    async retryLoadTasks(etapaDescricao, etapaId, etapaIndex) {
        // Remove from loaded set to allow retry
        this.loadedEtapas.delete(etapaId);
        delete this.taskCache[etapaId];
        
        // Retry loading
        await this.loadTasksForEtapa(etapaDescricao, etapaId, etapaIndex);
    }

    // Helper methods
    getStatusIcon(statusId) {
        switch (statusId) {
            case 1: return 'fa-clock';
            case 2: return 'fa-play';
            case 3: return 'fa-check';
            case 4: return 'fa-pause';
            default: return 'fa-question';
        }
    }

    getStatusClass(statusId) {
        switch (statusId) {
            case 1: return 'status-planejada';
            case 2: return 'status-em-execucao';
            case 3: return 'status-finalizada';
            case 4: return 'status-paralisada';
            default: return 'status-indefinido';
        }
    }

    getStatusDescription(statusId) {
        switch (statusId) {
            case 1: return 'Planejada';
            case 2: return 'Em Execução';
            case 3: return 'Finalizada';
            case 4: return 'Paralisada';
            default: return 'Indefinido';
        }
    }

    formatDate(dateString) {
        if (!dateString) return 'N/A';
        try {
            const date = new Date(dateString);
            return date.toLocaleDateString('pt-BR');
        } catch {
            return 'N/A';
        }
    }
}

