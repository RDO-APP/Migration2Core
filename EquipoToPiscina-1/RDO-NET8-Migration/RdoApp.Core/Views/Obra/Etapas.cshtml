// FRONTEND INTEGRITY FIX: Enhanced function implementations with error handling
function abrirHistoricoTarefa(tarefaId, descricaoTarefa) {
    RdoErrorHandler.safeExecute(() => {
        console.log('📊 Loading task history for:', tarefaId, descricaoTarefa);
        
        // Carregar dados do histórico via AJAX
        fetch(`/api/Medicao/${tarefaId}/historico`)
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                return response.json();
            })
            .then(data => {
                console.log('✅ History loaded successfully:', data);
                
                // Mostrar modal
                const modal = new bootstrap.Modal(document.getElementById('historicoModal'));
                modal.show();
            })
            .catch(error => {
                console.error('❌ Error loading task history:', error);
                RdoErrorHandler.showUserError('Erro ao carregar histórico da tarefa. Tente novamente.');
            });
    }, 'Não foi possível abrir o histórico da tarefa');
}

// Enhanced Nova Medição function with error handling
if (typeof abrirModalNovaMedicao === 'undefined') {
    function abrirModalNovaMedicao(tarefaId, descricaoTarefa) {
        RdoErrorHandler.safeExecute(() => {
            console.log('📝 Opening new measurement modal for:', tarefaId, descricaoTarefa);
            
            const tarefaIdElement = document.getElementById('tarefaIdModal');
            const tarefaDescricaoElement = document.getElementById('tarefaDescricaoModal');
            const dataMedicaoElement = document.getElementById('dataMedicao');
            
            if (!tarefaIdElement || !tarefaDescricaoElement) {
                throw new Error('Modal elements not found');
            }
            
            tarefaIdElement.value = tarefaId;
            tarefaDescricaoElement.textContent = descricaoTarefa;
            
            // Definir data atual
            if (dataMedicaoElement) {
                const hoje = new Date().toISOString().split('T')[0];
                dataMedicaoElement.value = hoje;
            }
            
            // Mostrar modal
            const modalElement = document.getElementById('novaMedicaoModal');
            if (modalElement) {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            } else {
                throw new Error('Nova Medição modal not found');
            }
        }, 'Não foi possível abrir o modal de nova medição');
    }
}

