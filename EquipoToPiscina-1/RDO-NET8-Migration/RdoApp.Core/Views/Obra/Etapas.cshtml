            </div>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">DescriÃ§Ã£o</label>
                    <input type="text" class="form-control" placeholder="Filtrar por descriÃ§Ã£o">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data Inicial Planejada</label>
                    <input type="date" class="form-control">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Data Final Planejada</label>
                    <input type="date" class="form-control">
                </div>
                <div class="col-md-4">
