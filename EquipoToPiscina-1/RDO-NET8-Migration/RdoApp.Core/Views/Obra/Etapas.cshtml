            </button>
            <button type="button" class="btn" title="Editar Obra">
                <i class="fas fa-edit"></i>
            </button>
            <button type="button" class="btn" title="Efetivo DiÃ¡rio">
                <i class="fas fa-list-alt"></i>
            </button>
            <button type="button" class="btn" title="Nova Tarefa" onclick="location.href='@Url.Action("NovaTarefa", "Obra")'">
                <i class="fas fa-clipboard"></i>
            </button>
            <button type="button" class="btn" title="Nova Etapa" onclick="location.href='@Url.Action("NovaEtapa", "Obra")'">
                <i class="fas fa-file"></i>
            </button>
            <button type="button" class="btn" title="Filtros" data-bs-toggle="collapse" data-bs-target="#filterSection">
                <i class="fas fa-filter"></i>
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="collapse" id="filterSection">
        <div class="filter-section">
            <div class="filter-buttons">
                <button class="btn btn-custom-dark" type="button" data-bs-toggle="collapse" data-bs-target="#filterSection">
