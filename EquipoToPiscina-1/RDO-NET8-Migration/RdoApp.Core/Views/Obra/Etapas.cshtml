    <!-- Accordion for Real Stages from Database -->
    <div class="accordion custom-accordion" id="etapasAccordion">
        @if (Model != null && Model.Any())
        {
            @foreach (var etapa in Model.Select((value, index) => new { value, index }))
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="etapa@(etapa.index)Header">
                        <button class="accordion-button @(etapa.index == 0 ? "" : "collapsed")" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#etapa@(etapa.index)" 
                                aria-expanded="@(etapa.index == 0 ? "true" : "false")"
