@model IEnumerable<RdoApp.Core.Models.ViewModels.EtapaViewModel>
@{
    ViewData["Title"] = "Etapas / Tarefas";
}
@{
    // FRONTEND INTEGRITY FIX: Enhanced model validation with safety checks
    var modelCount = Model?.Count() ?? 0;
    var safeModel = Model ?? new List<RdoApp.Core.Models.ViewModels.EtapaViewModel>();
    System.Console.WriteLine($"FRONTEND INTEGRITY FIX: Model count = {modelCount}");
    
    if (safeModel.Any()) {
        foreach (var etapa in safeModel) {
            System.Console.WriteLine($"FRONTEND INTEGRITY FIX: Etapa {etapa.Id}: {etapa.SafeDescricao} - {etapa.SafeTotalTarefas} tarefas (Fallback: {etapa.IsFallbackData})");
        }
    } else {
        System.Console.WriteLine("FRONTEND INTEGRITY FIX: Model is empty - this should not happen with safety render!");
    }
}

<!-- Modern Bootstrap 5 implementation with Gilberto's visual design -->
