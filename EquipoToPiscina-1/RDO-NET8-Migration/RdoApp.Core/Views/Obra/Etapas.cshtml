                    </h2>
                    <div id="etapa@(etapa.index)" class="accordion-collapse collapse @(etapa.index == 0 ? "show" : "")" data-bs-parent="#etapasAccordion">
                        <div class="accordion-body">
                            <div class="tasks-grid">
                                @if (etapa.value.Tarefas != null && etapa.value.Tarefas.Any())
                                {
                                    @foreach (var tarefa in etapa.value.Tarefas)
                                    {
                                        <div class="task-card">
                                            <div class="task-card-header @tarefa.StatusCssClass">
                                                <h6 class="task-card-title">@tarefa.Descricao</h6>
                                                <button class="task-card-menu" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @if (tarefa.PodeIniciar)
                                                    {
                                                        <li><a class="dropdown-item" href="#"><i class="fas fa-play me-1"></i> Iniciar</a></li>
                                                    }
                                                    @if (tarefa.PodePausar)
                                                    {
                                                        <li><a class="dropdown-item" href="#"><i class="fas fa-pause me-1"></i> Pausar</a></li>
                                                    }
                                                    @if (tarefa.PodeFinalizar)
                                                    {
                                                        <li><a class="dropdown-item" href="#"><i class="fas fa-check me-1"></i> Finalizar</a></li>
                                                    }
                                                </ul>
                                                
                                                <div class="task-card-stats">
                                                    <div class="task-card-stat">
                                                        <i class="fas fa-users"></i>
                                                        <span>@tarefa.QuantidadeColaboradores</span>
                                                    </div>
                                                    <div class="task-card-stat">
                                                        <i class="fas fa-tools"></i>
                                                        <span>@tarefa.QuantidadeEquipamentos</span>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="task-card-body">
                                                <div class="task-dates">
                                                    <div class="task-date planned">
                                                        <i class="fas fa-calendar-alt"></i>
                                                        <span>Planejado: @tarefa.DataInicio.ToString("dd/MM/yyyy") Ã  @(tarefa.DataPrevisaoFim?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                                    </div>
                                                    <div class="task-date executed">
                                                        <i class="fas fa-calendar-check"></i>
                                                        <span>Executado: @(tarefa.DataMedicao.ToString("dd/MM/yyyy")) Ã  @(tarefa.DataFim?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                                    </div>
                                                </div>
                                                
                                                <div class="task-progress">
                                                    <div class="progress-custom">
                                                        <div class="progress-bar-custom @(tarefa.PercentualExtrapolado ? "bg-warning" : "")" style="width: @Math.Min(tarefa.PercentualConclusao, 100)%;">
                                                            @tarefa.PercentualConclusaoFormatado
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="task-actions">
                                                    <button class="task-action-btn" title="Visualizar">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="task-action-btn" title="Histórico" onclick="abrirHistoricoTarefa(@tarefa.Id, '@tarefa.Descricao')">
                                                        <i class="fas fa-clock"></i>
                                                    </button>
                                                    @if (tarefa.PodeAdicionarMedicao)
                                                    {
                                                        <button class="task-action-btn" title="Nova Medição" onclick="abrirModalNovaMedicao(@tarefa.Id, '@tarefa.Descricao')">
                                                            <i class="fas fa-plus"></i>
                                                        </button>
                                                    }
                                                    @if (tarefa.PodeEditar)
                                                    {
                                                        <button class="task-action-btn" title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }
                                                    @if (tarefa.PodeExcluir)
                                                    {
                                                        <button class="task-action-btn" title="Excluir">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                                
                                                <button class="task-status-btn @tarefa.StatusCssClass">
                                                    <i class="fas @(tarefa.StatusId == 1 ? "fa-clock" : tarefa.StatusId == 2 ? "fa-play" : tarefa.StatusId == 3 ? "fa-check" : "fa-pause") me-1"></i>
                                                    @tarefa.StatusDescricao
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center w-100 mb-3">
                                        <p class="text-muted">@etapa.value.StatusSummary</p>
                                    </div>
                                }
                                
                                <!-- Add New Task Card -->
                                @if (etapa.value.CanAddTasks)
                                {
                                    <div class="add-task-card" onclick="location.href='@Url.Action("NovaTarefa", "Obra")?etapaId=@etapa.value.Id'">
                                        <div class="add-task-content">
                                            <i class="fas fa-clipboard"></i>
                                            <span>Adicionar nova tarefa</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2"></i>
                Nenhuma etapa encontrada para esta obra. 
                <a href="@Url.Action("NovaEtapa", "Obra")" class="alert-link">Clique aqui para adicionar uma nova etapa</a>.
            </div>
        }
    </div>
</div>

